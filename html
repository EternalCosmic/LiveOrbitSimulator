<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interstellar Spacecraft & Landing Simulator</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #010204;
      color: #00ffcc;
      font-family: 'Courier New', Courier, monospace;
      overflow: hidden;
      height: 100vh;
      width: 100vw;
    }

    #sim-container {
      position: relative;
      width: 100%;
      height: 100%;
    }

    canvas#webgl-canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    /* Astronaut Cockpit Viewport Frame */
    .cockpit-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 2;
      pointer-events: none;
      box-shadow: inset 0 0 140px rgba(0, 0, 0, 0.95);
      border: 24px solid #0f131a;
    }

    /* Futuristic HUD Interface */
    .hud-layer {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 3;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 28px;
      pointer-events: none;
    }

    .hud-title {
      text-align: center;
      font-size: 1.2rem;
      letter-spacing: 3px;
      text-shadow: 0 0 10px #00ffcc;
      background: rgba(4, 12, 20, 0.75);
      padding: 10px 20px;
      border-radius: 6px;
      align-self: center;
      border: 1px solid rgba(0, 255, 204, 0.4);
    }

    .hud-panels {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      width: 100%;
    }

    .panel {
      background: rgba(6, 14, 24, 0.88);
      border: 1px solid #00ffcc;
      padding: 18px 22px;
      border-radius: 8px;
      pointer-events: auto;
      backdrop-filter: blur(8px);
      min-width: 260px;
    }

    .panel h3 {
      font-size: 0.85rem;
      margin-bottom: 10px;
      color: #ffffff;
      border-bottom: 1px solid #00ffcc;
      padding-bottom: 4px;
      letter-spacing: 1px;
    }

    .metric {
      font-size: 1.1rem;
      font-weight: bold;
      margin-bottom: 8px;
      color: #00ffcc;
    }

    .control-btn {
      background: #002b26;
      color: #00ffcc;
      border: 1px solid #00ffcc;
      padding: 9px 14px;
      margin: 5px 0;
      cursor: pointer;
      width: 100%;
      font-family: inherit;
      font-weight: bold;
      border-radius: 4px;
      transition: all 0.2s ease-in-out;
    }

    .control-btn:hover {
      background: #00ffcc;
      color: #000000;
      box-shadow: 0 0 12px #00ffcc;
    }

    select.target-select {
      width: 100%;
      padding: 8px;
      background: #001f1c;
      color: #00ffcc;
      border: 1px solid #00ffcc;
      margin-bottom: 12px;
      font-family: inherit;
      border-radius: 4px;
    }
  </style>

  <!-- Three.js CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>

<div id="sim-container">
  <canvas id="webgl-canvas"></canvas>
  <div class="cockpit-overlay"></div>

  <div class="hud-layer">
    <div class="hud-title">INTERSTELLAR NAVIGATION &amp; LANDING SYSTEM</div>

    <div class="hud-panels">
      <!-- Flight Telemetry -->
      <div class="panel">
        <h3>FLIGHT TELEMETRY</h3>
        <div>ACTIVE SYSTEM:</div>
        <div class="metric" id="target-name">Earth System</div>
        <div>FLIGHT MODE:</div>
        <div class="metric" id="flight-mode">ORBITAL</div>
        <div>ALTITUDE / DISTANCE:</div>
        <div class="metric" id="alt-val">400.0 km</div>
        <div>VELOCITY:</div>
        <div class="metric" id="speed-val">7.68 km/s</div>
      </div>

      <!-- Navigation & Flight Commands -->
      <div class="panel">
        <h3>FLIGHT COMMANDS</h3>
        <label for="destination">DESTINATION SELECTION:</label>
        <select id="destination" class="target-select" onchange="changeDestination(this.value)">
          <option value="Earth">Earth System</option>
          <option value="Mars">Mars System</option>
          <option value="Andromeda">Andromeda Sector</option>
        </select>
        <button class="control-btn" onclick="toggleWarp()">[ Interstellar Warp Drive ]</button>
        <button class="control-btn" onclick="initiateLanding()">[ Initiate Surface Landing ]</button>
        <button class="control-btn" onclick="returnToOrbit()">[ Ascent to Orbit ]</button>
      </div>
    </div>
  </div>
</div>

<script>
  let scene, camera, renderer, starfield;
  let currentBody;
  
  // Simulation State
  let currentTarget = 'Earth';
  let mode = 'ORBITAL'; 
  let altitude = 400.0;
  let speed = 7.68;
  let descentInterval = null;

  const targetSpecs = {
    Earth: { color: 0x1166ff, orbitAlt: 400, orbitSpeed: 7.68 },
    Mars: { color: 0xcc4422, orbitAlt: 320, orbitSpeed: 3.55 },
    Andromeda: { color: 0x8844ff, orbitAlt: 2500, orbitSpeed: 25.0 }
  };

  function init() {
    scene = new THREE.Scene();
    camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 2000);
    camera.position.set(0, 0, 10);

    renderer = new THREE.WebGLRenderer({ canvas: document.getElementById('webgl-canvas'), antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(window.devicePixelRatio);

    // Lighting
    const sunLight = new THREE.DirectionalLight(0xffffff, 1.3);
    sunLight.position.set(100, 50, 100);
    scene.add(sunLight);
    scene.add(new THREE.AmbientLight(0x222233));

    // Dynamic Deep Space Starfield
    const starGeo = new THREE.BufferGeometry();
    const starCount = 4000;
    const starPositions = new Float32Array(starCount * 3);

    for (let i = 0; i < starCount * 3; i += 3) {
      starPositions[i] = (Math.random() - 0.5) * 1600;
      starPositions[i + 1] = (Math.random() - 0.5) * 1600;
      starPositions[i + 2] = (Math.random() - 0.5) * 1600;
    }
    starGeo.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
    const starMat = new THREE.PointsMaterial({ color: 0xffffff, size: 1.2 });
    starfield = new THREE.Points(starGeo, starMat);
    scene.add(starfield);

    // Initial Planet Creation
    createCelestialBody(targetSpecs.Earth.color);

    window.addEventListener('resize', onWindowResize);
    animate();
  }

  function createCelestialBody(colorHex) {
    if (currentBody) scene.remove(currentBody);
    
    const geometry = new THREE.SphereGeometry(4, 64, 64);
    const material = new THREE.MeshPhongMaterial({
      color: colorHex,
      shininess: 20
    });
    currentBody = new THREE.Mesh(geometry, material);
    currentBody.position.set(0, -2, -12);
    scene.add(currentBody);
  }

  function animate() {
    requestAnimationFrame(animate);

    if (mode === 'ORBITAL') {
      currentBody.rotation.y += 0.003;
      starfield.rotation.y += 0.0002;
    } else if (mode === 'WARP') {
      starfield.position.z += 12;
      if (starfield.position.z > 500) starfield.position.z = 0;
      currentBody.position.z += 0.15;
    } else if (mode === 'LANDED') {
      currentBody.rotation.y += 0.0004;
    }

    renderer.render(scene, camera);
  }

  function changeDestination(target) {
    if (descentInterval) clearInterval(descentInterval);
    currentTarget = target;
    const spec = targetSpecs[target];
    createCelestialBody(spec.color);
    altitude = spec.orbitAlt;
    speed = spec.orbitSpeed;
    mode = 'ORBITAL';
    currentBody.position.set(0, -2, -12);
    updateUI();
  }

  function toggleWarp() {
    if (descentInterval) clearInterval(descentInterval);
    if (mode === 'WARP') {
      mode = 'ORBITAL';
      speed = targetSpecs[currentTarget].orbitSpeed;
    } else {
      mode = 'WARP';
      speed = 299792; // Speed of Light
    }
    updateUI();
  }

  function initiateLanding() {
    if (mode === 'LANDED' || mode === 'LANDING SEQUENCE') return;
    mode = 'LANDING SEQUENCE';
    updateUI();

    descentInterval = setInterval(() => {
      if (altitude > 0) {
        altitude -= 15;
        currentBody.position.y += 0.2;
        currentBody.position.z += 0.25;
        speed = Math.max(0, (altitude / 12).toFixed(1));
        updateUI();
      } else {
        clearInterval(descentInterval);
        mode = 'LANDED';
        altitude = 0.0;
        speed = 0.0;
        updateUI();
      }
    }, 100);
  }

  function returnToOrbit() {
    if (descentInterval) clearInterval(descentInterval);
    const spec = targetSpecs[currentTarget];
    mode = 'ORBITAL';
    altitude = spec.orbitAlt;
    speed = spec.orbitSpeed;
    currentBody.position.set(0, -2, -12);
    updateUI();
  }

  function updateUI() {
    document.getElementById('target-name').textContent = `${currentTarget} System`;
    document.getElementById('flight-mode').textContent = mode;
    document.getElementById('alt-val').textContent = `${altitude.toFixed(1)} km`;
    document.getElementById('speed-val').textContent = `${speed} km/s`;
  }

  function onWindowResize() {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  }

  window.onload = init;
</script>
</body>
</html>
