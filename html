<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Deep Space Cockpit & Landing Simulator</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: #020408;
      color: #00ffcc;
      font-family: 'Courier New', Courier, monospace;
      overflow: hidden;
      height: 100vh;
      width: 100vw;
    }

    #sim-container {
      position: relative;
      width: 100%;
      height: 100%;
    }

    canvas#webgl-canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    /* Cockpit Frame Window Mask */
    .cockpit-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 2;
      pointer-events: none;
      box-shadow: inset 0 0 120px rgba(0, 0, 0, 0.9);
      border: 18px solid #12161f;
    }

    /* Interactive HUD Display */
    .hud-layer {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 3;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 24px;
      pointer-events: none;
    }

    .hud-title {
      text-align: center;
      font-size: 1.3rem;
      letter-spacing: 3px;
      text-shadow: 0 0 8px #00ffcc;
      background: rgba(4, 12, 20, 0.6);
      padding: 8px 16px;
      border-radius: 4px;
      align-self: center;
      border: 1px solid rgba(0, 255, 204, 0.3);
    }

    .hud-panels {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      width: 100%;
    }

    .panel {
      background: rgba(8, 16, 26, 0.85);
      border: 1px solid #00ffcc;
      padding: 16px 20px;
      border-radius: 8px;
      pointer-events: auto;
      backdrop-filter: blur(6px);
      min-width: 240px;
    }

    .panel h3 {
      font-size: 0.85rem;
      margin-bottom: 8px;
      color: #ffffff;
      border-bottom: 1px solid #00ffcc;
      padding-bottom: 4px;
      letter-spacing: 1px;
    }

    .metric {
      font-size: 1.1rem;
      font-weight: bold;
      margin-bottom: 6px;
      color: #00ffcc;
    }

    .control-btn {
      background: #002b26;
      color: #00ffcc;
      border: 1px solid #00ffcc;
      padding: 8px 12px;
      margin: 4px 0;
      cursor: pointer;
      width: 100%;
      font-family: inherit;
      font-weight: bold;
      border-radius: 4px;
      transition: all 0.2s;
    }

    .control-btn:hover {
      background: #00ffcc;
      color: #000000;
      box-shadow: 0 0 10px #00ffcc;
    }

    select.target-select {
      width: 100%;
      padding: 6px;
      background: #001f1c;
      color: #00ffcc;
      border: 1px solid #00ffcc;
      margin-bottom: 10px;
      font-family: inherit;
    }
  </style>

  <!-- Three.js Library -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>

<div id="sim-container">
  <canvas id="webgl-canvas"></canvas>
  <div class="cockpit-overlay"></div>

  <div class="hud-layer">
    <div class="hud-title">DEEP SPACE NAVIGATION &amp; LANDING SYSTEM</div>

    <div class="hud-panels">
      <!-- Telemetry Panel -->
      <div class="panel">
        <h3>FLIGHT TELEMETRY</h3>
        <div>TARGET SYSTEM:</div>
        <div class="metric" id="target-name">Earth Orbit</div>
        <div>FLIGHT MODE:</div>
        <div class="metric" id="flight-mode">ORBITAL</div>
        <div>ALTITUDE / DISTANCE:</div>
        <div class="metric" id="alt-val">400.0 km</div>
        <div>VELOCITY:</div>
        <div class="metric" id="speed-val">7.68 km/s</div>
      </div>

      <!-- Navigation & Flight Controls -->
      <div class="panel">
        <h3>FLIGHT COMMANDS</h3>
        <label for="destination">SELECT DESTINATION:</label>
        <select id="destination" class="target-select" onchange="changeDestination(this.value)">
          <option value="Earth">Earth System</option>
          <option value="Mars">Mars System</option>
          <option value="Andromeda">Andromeda Galaxy Sector</option>
        </select>
        <button class="control-btn" onclick="toggleWarp()">[ Warp Drive / Interstellar ]</button>
        <button class="control-btn" onclick="initiateLanding()">[ Initiate Planetary Landing ]</button>
        <button class="control-btn" onclick="returnToOrbit()">[ Ascent to Orbit ]</button>
      </div>
    </div>
  </div>
</div>

<script>
  let scene, camera, renderer, starfield;
  let currentBody, atmosphericGlow, surfaceTerrain;
  
  // Navigation Parameters
  let currentTarget = 'Earth';
  let mode = 'ORBITAL'; // ORBITAL, WARP, LANDED
  let altitude = 400.0;
  let speed = 7.68;

  const targetSpecs = {
    Earth: { color: 0x1166ff, surface: 0x228844, orbitAlt: 400, orbitSpeed: 7.68 },
    Mars: { color: 0xcc4422, surface: 0x993311, orbitAlt: 320, orbitSpeed: 3.55 },
    Andromeda: { color: 0x8844ff, surface: 0x441166, orbitAlt: 2500, orbitSpeed: 25.0 }
  };

  function init() {
    const container = document.getElementById('sim-container');
    
    // Three.js Scene Setup
    scene = new THREE.Scene();
    camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 2000);
    camera.position.set(0, 0, 10);

    renderer = new THREE.WebGLRenderer({ canvas: document.getElementById('webgl-canvas'), antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(window.devicePixelRatio);

    // Lighting
    const sunLight = new THREE.DirectionalLight(0xffffff, 1.2);
    sunLight.position.set(100, 50, 100);
    scene.add(sunLight);
    scene.add(new THREE.AmbientLight(0x333344));

    // Deep Space Starfield
    const starGeo = new THREE.BufferGeometry();
    const starCount = 3000;
    const starPositions = new Float32Array(starCount * 3);

    for (let i = 0; i < starCount * 3; i += 3) {
      starPositions[i] = (Math.random() - 0.5) * 1600;
      starPositions[i + 1] = (Math.random() - 0.5) * 1600;
      starPositions[i + 2] = (Math.random() - 0.5) * 1600;
    }
    starGeo.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
    const starMat = new THREE.PointsMaterial({ color: 0xffffff, size: 1.2 });
    starfield = new THREE.Points(starGeo, starMat);
    scene.add(starfield);

    // Create Initial Planetary Sphere
    createCelestialBody(targetSpecs.Earth.color);

    window.addEventListener('resize', onWindowResize);
    animate();
  }

  function createCelestialBody(colorHex) {
    if (currentBody) scene.remove(currentBody);
    
    const geometry = new THREE.SphereGeometry(4, 64, 64);
    const material = new THREE.MeshPhongMaterial({
      color: colorHex,
      wireframe: false,
      shininess: 15
    });
    currentBody = new THREE.Mesh(geometry, material);
    currentBody.position.set(0, -2, -12);
    scene.add(currentBody);
  }

  function animate() {
    requestAnimationFrame(animate);

    // Dynamic rotation & movement based on mode
    if (mode === 'ORBITAL') {
      currentBody.rotation.y += 0.003;
      starfield.rotation.y += 0.0002;
    } else if (mode === 'WARP') {
      starfield.position.z += 10;
      if (starfield.position.z > 500) starfield.position.z = 0;
      currentBody.position.z += 0.2;
    } else if (mode === 'LANDED') {
      currentBody.rotation.y += 0.0005;
    }

    renderer.render(scene, camera);
  }

  // Navigation Logic
  function changeDestination(target) {
    currentTarget = target;
    const spec = targetSpecs[target];
    createCelestialBody(spec.color);
    altitude = spec.orbitAlt;
    speed = spec.orbitSpeed;
    mode = 'ORBITAL';
    currentBody.position.set(0, -2, -12);
    updateUI();
  }

  function toggleWarp() {
    if (mode === 'WARP') {
      mode = 'ORBITAL';
    } else {
      mode = 'WARP';
      speed = 299792; // Speed of light callout
    }
    updateUI();
  }

  function initiateLanding() {
    if (mode === 'LANDED') return;
    mode = 'LANDING SEQUENCE';
    updateUI();

    // Smooth landing descent camera animation
    let descent = setInterval(() => {
      if (altitude > 0) {
        altitude -= 20;
        currentBody.position.y += 0.25;
        currentBody.position.z += 0.3;
        speed = Math.max(0, (altitude / 10).toFixed(1));
        updateUI();
      } else {
        clearInterval(descent);
        mode = 'LANDED';
        altitude = 0.0;
        speed = 0.0;
        updateUI();
      }
    }, 100);
  }

  function returnToOrbit() {
    const spec = targetSpecs[currentTarget];
    mode = 'ORBITAL';
    altitude = spec.orbitAlt;
    speed = spec.orbitSpeed;
    currentBody.position.set(0, -2, -12);
    updateUI();
  }

  function updateUI() {
    document.getElementById('target-name').textContent = currentTarget;
    document.getElementById('flight-mode').textContent = mode;
    document.getElementById('alt-val').textContent = `${altitude.toFixed(1)} km`;
    document.getElementById('speed-val').textContent = `${speed} km/s`;
  }

  function onWindowResize() {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  }

  window.onload = init;
</script>
</body>
</html>
